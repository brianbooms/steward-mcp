# Steward MCP server — environment template.
# Copy to .env and fill in. Never commit a filled .env.

# REQUIRED: hex private key of YOUR Base wallet that funds the $0.01/call payments.
# The server uses it only to sign per-call EIP-3009 authorizations.
# It never leaves your machine. Fund the wallet with a few USDC on Base.
STEWARD_PAYER_KEY=0x...

# OPTIONAL: hard ceiling per single tool call, in USDC. Default 0.05.
# The server refuses to sign any quote above this.
STEWARD_MAX_SPEND_USDC=0.05

# OPTIONAL: hard ceiling per rolling 24h, in USDC. Default 5.00.
STEWARD_MAX_SPEND_DAY_USDC=5.00

# OPTIONAL: override the rail base URL (default https://pay.brianbooms.com).
# STEWARD_RAIL_URL=https://pay.brianbooms.com
